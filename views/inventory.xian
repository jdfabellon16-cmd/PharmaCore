{{> head}}
<body><div class="app-shell">{{> sidebar}}<div class="main-shell"><header class="topbar">Stock control<strong>{{user.name}}</strong></header><main class="content">
  <div class="page-heading"><div><p class="eyebrow">INVENTORY HEALTH</p><h1>Inventory monitoring</h1><p class="muted">Low stock, expired, and near-expiry products with a movement audit trail.</p></div></div>
  <section class="panel"><h2>Alerts and stock adjustments</h2><div class="table-wrap"><table data-keyboard-table><thead><tr><th>Medicine</th><th>Stock</th><th>Minimum</th><th>Expiry</th><th>Adjust stock</th></tr></thead><tbody>{{#each medicines}}<tr><td><a class="text-link" href="/medicines/{{id}}">{{name}}</a><small class="table-sub">{{code}} · {{Category.name}}</small></td><td>{{stock}}</td><td>{{minimumStock}}</td><td>{{expirationDate}}</td><td><form class="adjust-form" data-keyboard-form method="post" action="/inventory/{{id}}/adjustments"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><input type="number" name="quantityChange" data-row-key="A" data-shortcut-label="Adjust stock" step="1" required placeholder="+/- qty"><input name="reason" required placeholder="Reason"><button class="button button-secondary">Record</button></form></td></tr>{{else}}<tr data-no-row><td colspan="5" class="empty-state">No low-stock or expiry alerts.</td></tr>{{/each}}</tbody></table></div></section>
  <section class="panel"><div class="panel-heading"><h2>Recent inventory movements</h2></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Medicine</th><th>Type</th><th>Change</th><th>Stock after</th><th>Reason</th><th>Staff</th></tr></thead><tbody>{{#each movements}}<tr><td>{{createdAt}}</td><td>{{Medicine.name}}</td><td>{{type}}</td><td>{{quantityChange}}</td><td>{{stockAfter}}</td><td>{{reason}}</td><td>{{User.name}}</td></tr>{{else}}<tr><td colspan="7" class="empty-state">No movements recorded.</td></tr>{{/each}}</tbody></table></div></section>
</main></div></div><script src="/js/page-keyboard.js" defer></script>{{> footer}}
