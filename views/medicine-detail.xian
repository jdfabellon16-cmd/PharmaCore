{{> head}}
<body><div class="app-shell">{{> sidebar}}<div class="main-shell"><header class="topbar"><a href="/medicines" class="text-link" data-form-cancel>← Medicines</a><strong>{{user.name}}</strong></header><main class="content">
  <div class="page-heading"><div><p class="eyebrow">{{medicine.code}}</p><h1>{{medicine.name}}</h1><p class="muted">{{medicine.genericName}} {{medicine.strength}} {{medicine.dosageForm}}</p></div><span class="badge {{#if (lte medicine.stock medicine.minimumStock)}}badge-warn{{else}}badge-ok{{/if}}">{{medicine.stock}} in stock</span></div>
  <section class="panel"><div class="detail-grid"><div><span>Brand</span><strong>{{medicine.brandName}}</strong></div><div><span>Unit price</span><strong>₱{{medicine.price}}</strong></div><div><span>Category</span><strong>{{medicine.Category.name}}</strong></div><div><span>Supplier</span><strong>{{medicine.Supplier.name}}</strong></div><div><span>Batch</span><strong>{{medicine.batchNumber}}</strong></div><div><span>Expiry</span><strong>{{medicine.expirationDate}}</strong></div><div><span>Minimum stock</span><strong>{{medicine.minimumStock}}</strong></div><div><span>Prescription required</span><strong>{{#if medicine.requiresPrescription}}Yes{{else}}No{{/if}}</strong></div></div><p>{{medicine.description}}</p></section>
  {{#if isAdmin}}{{#if medicine.active}}<section class="panel"><div class="panel-heading"><h2>Edit medicine</h2></div><form class="form-grid" method="post" action="/medicines/{{medicine.id}}" data-keyboard-form><input type="hidden" name="_csrf" value="{{csrfToken}}">
    <label>Code<input name="code" value="{{medicine.code}}" required></label><label>Name<input name="name" value="{{medicine.name}}" required></label><label>Generic name<input name="genericName" value="{{medicine.genericName}}"></label><label>Brand name<input name="brandName" value="{{medicine.brandName}}"></label><label>Strength<input name="strength" value="{{medicine.strength}}"></label><label>Dosage form<input name="dosageForm" value="{{medicine.dosageForm}}"></label><label>Price<input name="price" type="number" min="0" step="0.01" value="{{medicine.price}}" required></label><label>Minimum stock<input name="minimumStock" type="number" min="0" value="{{medicine.minimumStock}}" required></label><label>Batch number<input name="batchNumber" value="{{medicine.batchNumber}}"></label><label>Expiry date<input name="expirationDate" type="date" value="{{medicine.expirationDate}}"></label><label>Category<select name="categoryId"><option value="">None</option>{{#each categories}}<option value="{{id}}" {{#if (eq id ../medicine.categoryId)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Supplier<select name="supplierId"><option value="">None</option>{{#each suppliers}}<option value="{{id}}" {{#if (eq id ../medicine.supplierId)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label class="check-label"><input type="checkbox" name="requiresPrescription" {{#if medicine.requiresPrescription}}checked{{/if}}> Prescription required</label><label class="span-all">Description<textarea name="description">{{medicine.description}}</textarea></label><div class="span-all"><button class="button button-primary">Save changes</button></div>
  </form></section>{{#if (eq medicine.stock 0)}}<form method="post" action="/medicines/{{medicine.id}}/archive" data-confirm="Archive this medicine? Its history will be retained."><input type="hidden" name="_csrf" value="{{csrfToken}}"><button class="button button-danger">Archive medicine</button></form>{{/if}}{{else}}<section class="panel"><p>This medicine is archived; its sales and movement history are retained.</p></section>{{/if}}{{/if}}
  <section class="panel"><h2>Stock movement history</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Movement</th><th>Change</th><th>Stock after</th><th>Reason</th><th>Staff</th></tr></thead><tbody>{{#each medicine.InventoryMovements}}<tr><td>{{createdAt}}</td><td>{{type}}</td><td>{{quantityChange}}</td><td>{{stockAfter}}</td><td>{{reason}}</td><td>{{User.name}}</td></tr>{{else}}<tr><td colspan="6" class="empty-state">No movement records yet.</td></tr>{{/each}}</tbody></table></div></section>
</main></div></div><script src="/js/page-keyboard.js" defer></script>{{> footer}}
