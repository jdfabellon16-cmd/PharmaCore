{{> head}}
<body><div class="app-shell">{{> sidebar}}<div class="main-shell"><header class="topbar">Inventory catalog<strong>{{user.name}}</strong></header><main class="content">
  <div class="page-heading"><div><p class="eyebrow">CATALOG</p><h1>Medicines</h1><p class="muted">Search current products, batches, and stock levels.</p></div></div>
  <section class="panel"><form class="filter-row" method="get" action="/medicines"><input type="search" data-page-search name="search" placeholder="Search name, generic name, or code" value="{{search}}"><select name="category" data-page-filter><option value="">All categories</option>{{#each categories}}<option value="{{id}}" {{#if (eq id ../selectedCategory)}}selected{{/if}}>{{name}}</option>{{/each}}</select><select name="stock" data-page-filter><option value="">All stock</option><option value="low" {{#if (eq stockFilter "low")}}selected{{/if}}>Low stock</option><option value="empty" {{#if (eq stockFilter "empty")}}selected{{/if}}>Out of stock</option></select><button class="button button-secondary">Filter</button></form>
    <div class="table-wrap"><table data-keyboard-table><thead><tr><th>Code / medicine</th><th>Category</th><th>Batch / expiry</th><th>Price</th><th>Stock</th><th></th></tr></thead><tbody>
      {{#each medicines}}<tr><td><strong>{{name}}</strong><small class="table-sub">{{code}}{{#if genericName}} · {{genericName}}{{/if}}</small></td><td>{{Category.name}}</td><td>{{batchNumber}}<small class="table-sub">{{expirationDate}}</small></td><td>₱{{price}}</td><td>{{#if (lte stock minimumStock)}}<span class="badge badge-warn">{{stock}} low</span>{{else}}<span class="badge badge-ok">{{stock}}</span>{{/if}}</td><td><a class="text-link" href="/medicines/{{id}}" data-row-key="Enter">Details</a></td></tr>{{else}}<tr data-no-row><td colspan="6" class="empty-state">No medicines found.</td></tr>{{/each}}
    </tbody></table></div>
  </section>
  {{#if isAdmin}}<section class="panel"><div class="panel-heading"><div><h2>Add medicine</h2><p class="muted">Initial stock is recorded as an opening stock movement.</p></div></div>
    <form class="form-grid" method="post" action="/medicines" data-keyboard-form><input type="hidden" name="_csrf" value="{{csrfToken}}">
      <label>Medicine code<input name="code" required maxlength="80" data-shortcut="N" data-shortcut-label="Add medicine"></label><label>Medicine name<input name="name" required maxlength="180"></label>
      <label>Generic name<input name="genericName"></label><label>Brand name<input name="brandName"></label>
      <label>Strength<input name="strength"></label><label>Dosage form<input name="dosageForm" placeholder="Tablet, capsule, syrup"></label>
      <label>Unit price<input name="price" type="number" min="0" step="0.01" required></label><label>Opening stock<input name="stock" type="number" min="0" step="1" value="0" required></label>
      <label>Minimum stock<input name="minimumStock" type="number" min="0" step="1" value="5" required></label><label>Batch / lot number<input name="batchNumber"></label>
      <label>Expiration date<input name="expirationDate" type="date"></label><label>Category<select name="categoryId"><option value="">None</option>{{#each categories}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
      <label>Supplier<select name="supplierId"><option value="">None</option>{{#each suppliers}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
      <label class="check-label"><input type="checkbox" name="requiresPrescription"> Prescription required</label>
      <label class="span-all">Description<textarea name="description" rows="2"></textarea></label>
      <div class="span-all"><button class="button button-primary">Save medicine</button></div>
    </form>
  </section>{{/if}}
</main></div></div><script src="/js/page-keyboard.js" defer></script>{{> footer}}
