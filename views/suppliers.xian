{{> head}}
<body><div class="app-shell">{{> sidebar}}<div class="main-shell"><header class="topbar">Catalog management<strong>{{user.name}}</strong></header><main class="content">
  <div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Suppliers</h1><p class="muted">Supplier records do not change inventory quantities.</p></div></div>
  <section class="panel"><h2>Add supplier</h2><form class="form-grid" method="post" action="/suppliers" data-keyboard-form><input type="hidden" name="_csrf" value="{{csrfToken}}"><label>Name<input name="name" required data-shortcut="N" data-shortcut-label="Add supplier"></label><label>Phone<input name="phone"></label><label>Email<input name="email" type="email"></label><label>Address<input name="address"></label><div><button class="button button-primary">Add supplier</button></div></form></section>
  <section class="panel"><form class="filter-row" method="get" action="/suppliers"><input type="search" data-page-search name="search" value="{{search}}" placeholder="Search supplier"><button class="button button-secondary">Search</button></form>
  <div class="table-wrap"><table data-keyboard-table><thead><tr><th>Supplier</th><th>Contact</th><th>Address</th><th>Medicines</th><th>Update / delete</th></tr></thead><tbody>{{#each suppliers}}<tr><td>{{this.name}}</td><td>{{this.phone}}<small class="table-sub">{{this.email}}</small></td><td>{{this.address}}</td><td>{{#each this.Medicines}}<a class="text-link" href="/medicines/{{this.id}}">{{this.name}}</a><small class="table-sub">{{this.code}}</small>{{else}}None{{/each}}</td><td><details><summary data-row-key="E">Edit</summary><form class="stack-form compact-form" method="post" action="/suppliers/{{this.id}}/update"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><label>Name<input name="name" value="{{this.name}}" required></label><label>Phone<input name="phone" value="{{this.phone}}"></label><label>Email<input name="email" type="email" value="{{this.email}}"></label><label>Address<input name="address" value="{{this.address}}"></label><button class="button button-secondary">Save</button></form><form method="post" action="/suppliers/{{this.id}}/delete" data-confirm="Delete this unused supplier?"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><button class="button button-danger" data-row-key="Delete" {{#if this.Medicines.length}}disabled title="Supplier is in use"{{/if}}>Delete</button></form></details></td></tr>{{else}}<tr data-no-row><td colspan="5" class="empty-state">No suppliers found.</td></tr>{{/each}}</tbody></table></div></section>
</main></div></div><script src="/js/page-keyboard.js" defer></script>{{> footer}}
