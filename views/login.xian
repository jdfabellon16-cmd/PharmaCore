{{> head}}
<body class="auth-page">
  <main class="auth-card">
    <a class="brand auth-brand" href="/"><span class="brand-mark">+</span><span>PharmaCore<small>Pharmacy management</small></span></a>
    <p class="eyebrow">TEAM ACCESS</p><h1>Welcome back</h1><p class="muted">Sign in with your authorized staff account.</p>
    {{#if error}}<div class="alert alert-error">{{error}}</div>{{/if}}
    {{#if success}}<div class="alert alert-success">{{success}}</div>{{/if}}
    <form class="stack-form" method="post" action="/login">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <label>Email address<input type="email" name="email" autocomplete="username" required></label>
      <label>Password<input type="password" name="password" autocomplete="current-password" required></label>
      <button class="button button-primary full-width" type="submit">Sign in</button>
    </form>
    <p class="small-muted">New to PharmaCore? <a class="text-link" href="/register">Request an account</a></p>
  </main>
{{> footer}}
