{{> head}}
<body><div class="app-shell">{{> sidebar}}<div class="main-shell"><header class="topbar">Sales analytics<strong>{{user.name}}</strong></header><main class="content">
  <div class="page-heading"><div><p class="eyebrow">ANALYTICS</p><h1>Reports</h1><p class="muted">Sales summaries are calculated from completed database transactions.</p></div><div class="no-print"><a class="button button-secondary" href="/reports/export.csv?from={{from}}&to={{to}}" data-shortcut="X">Export CSV</a><button class="button button-primary" onclick="window.print()" data-shortcut="P">Print</button></div></div>
  <section class="panel"><form class="filter-row" method="get" action="/reports"><label>Period<select name="period" data-page-filter><option value="daily" {{#if (eq period "daily")}}selected{{/if}}>Today</option><option value="weekly" {{#if (eq period "weekly")}}selected{{/if}}>This week</option><option value="monthly" {{#if (eq period "monthly")}}selected{{/if}}>This month</option><option value="custom" {{#if (eq period "custom")}}selected{{/if}}>Custom date range</option></select></label><label>From<input type="date" name="from" value="{{from}}" required onchange="this.form.period.value = 'custom'"></label><label>To<input type="date" name="to" value="{{to}}" required onchange="this.form.period.value = 'custom'"></label><button class="button button-primary">Run report</button></form></section>
  <section class="stat-grid report-stats"><article class="stat-card"><span>Sales total</span><strong>₱{{summary.total}}</strong><small>Selected date range</small></article><article class="stat-card"><span>Transactions</span><strong>{{summary.count}}</strong><small>Completed sales</small></article></section>
  <section class="panel"><h2>Sales by payment method</h2>{{#each summary.paymentBars}}<div class="report-bar-row"><div><span>{{method}}</span><strong>₱{{amount}}</strong></div><div class="report-bar-track"><span style="width: {{share}}%"></span></div></div>{{else}}<p class="empty-state">No sales in this date range.</p>{{/each}}</section>
  <section class="panel"><h2>Sales by cashier</h2><div class="table-wrap"><table><thead><tr><th>Cashier</th><th>Total sales</th></tr></thead><tbody>{{#each summary.cashierTotals}}<tr><td>{{name}}</td><td>₱{{amount}}</td></tr>{{else}}<tr><td colspan="2" class="empty-state">No sales in this date range.</td></tr>{{/each}}</tbody></table></div></section>
  <section class="panel"><h2>Best sellers by quantity</h2><div class="table-wrap"><table><thead><tr><th>Medicine</th><th>Units sold</th></tr></thead><tbody>{{#each summary.topItems}}<tr><td>{{name}}</td><td>{{quantity}}</td></tr>{{else}}<tr><td colspan="2" class="empty-state">No item sales in this date range.</td></tr>{{/each}}</tbody></table></div></section>
  <section class="panel"><h2>Current inventory</h2><div class="table-wrap"><table><thead><tr><th>Code</th><th>Medicine</th><th>Category</th><th>Stock</th><th>Unit price</th><th>Expiry</th></tr></thead><tbody>{{#each inventory}}<tr><td>{{code}}</td><td>{{name}}</td><td>{{Category.name}}</td><td>{{stock}}</td><td>₱{{price}}</td><td>{{expirationDate}}</td></tr>{{else}}<tr><td colspan="6" class="empty-state">No active medicines.</td></tr>{{/each}}</tbody></table></div></section>
  <section class="panel"><h2>Low stock</h2><div class="table-wrap"><table><thead><tr><th>Medicine</th><th>Current</th><th>Minimum</th></tr></thead><tbody>{{#each lowStock}}<tr><td>{{name}}</td><td>{{stock}}</td><td>{{minimumStock}}</td></tr>{{else}}<tr><td colspan="3" class="empty-state">No medicines below their stock threshold.</td></tr>{{/each}}</tbody></table></div></section>
  <section class="panel"><h2>Expired and expiring within 30 days</h2><div class="table-wrap"><table><thead><tr><th>Medicine</th><th>Batch</th><th>Stock</th><th>Expiry</th></tr></thead><tbody>{{#each expiring}}<tr><td>{{name}}</td><td>{{batchNumber}}</td><td>{{stock}}</td><td>{{expirationDate}}</td></tr>{{else}}<tr><td colspan="4" class="empty-state">No expired or near-expiry medicines.</td></tr>{{/each}}</tbody></table></div></section>
</main></div></div><script src="/js/page-keyboard.js" defer></script>{{> footer}}
