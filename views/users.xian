{{> head}}
<body><div class="app-shell">{{> sidebar}}<div class="main-shell"><header class="topbar">Access control<strong>{{user.name}}</strong></header><main class="content">
  <div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>User management</h1><p class="muted">Create staff accounts and assign least-privilege roles.</p></div></div>
  <section class="panel"><h2>Create staff account</h2><form class="form-grid" method="post" action="/users" data-keyboard-form><input type="hidden" name="_csrf" value="{{csrfToken}}"><label>Full name<input name="name" required data-shortcut="N" data-shortcut-label="Add user"></label><label>Email<input name="email" type="email" required></label><label>Temporary password<input name="password" type="password" minlength="10" required><small>At least 10 characters</small></label><label>Role<select name="role" required><option value="cashier">Cashier</option><option value="pharmacist">Pharmacist</option><option value="admin">Administrator</option></select></label><label>Branch<select name="branchId"><option value="">Store default</option>{{#each branches}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><div><button class="button button-primary">Create account</button></div></form></section>
  <section class="panel"><h2>Staff accounts</h2><div class="table-wrap"><table data-keyboard-table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Branch</th><th>Status</th><th>Access</th></tr></thead><tbody>{{#each users}}<tr><td>{{this.name}}</td><td>{{this.email}}</td><td>{{this.role}}</td><td><form class="inline-form" method="post" action="/users/{{this.id}}/branch" data-keyboard-form><input type="hidden" name="_csrf" value="{{../csrfToken}}"><select name="branchId" aria-label="Branch for {{this.name}}" data-row-key="B" data-shortcut-label="Change branch"><option value="">Store default</option>{{#each this.branchOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><button class="button button-secondary">Save</button></form></td><td>{{#if this.active}}Active{{else}}Inactive{{/if}}</td><td><form method="post" action="/users/{{this.id}}/toggle" data-confirm="Change this account's active status?"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><button class="button button-secondary" data-row-key="Delete" data-shortcut-label="Activate / deactivate">{{#if this.active}}Deactivate{{else}}Activate{{/if}}</button></form></td></tr>{{else}}<tr data-no-row><td colspan="6" class="empty-state">No staff accounts have been registered yet.</td></tr>{{/each}}</tbody></table></div></section>
</main></div></div><script src="/js/page-keyboard.js" defer></script>{{> footer}}
