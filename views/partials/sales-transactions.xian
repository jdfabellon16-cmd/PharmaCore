<section class="panel">
  <form class="filter-row" method="get" action="/transactions">
    <label>Reference or cashier<input type="search" data-page-search name="search" value="{{search}}" placeholder="Search reference or cashier"></label>
    <label>From<input type="date" data-page-filter name="from" value="{{from}}"></label>
    <label>To<input type="date" name="to" value="{{to}}"></label>
    <select name="paymentMethod" data-page-filter aria-label="Payment method">
      <option value="">All payment methods</option>
      <option value="cash" {{#if (eq paymentMethod "cash")}}selected{{/if}}>Cash</option>
      <option value="card" {{#if (eq paymentMethod "card")}}selected{{/if}}>Card</option>
      <option value="mobile" {{#if (eq paymentMethod "mobile")}}selected{{/if}}>Mobile</option>
    </select>
    <select name="status" data-page-filter aria-label="Status">
      <option value="">All statuses</option>
      <option value="completed" {{#if (eq status "completed")}}selected{{/if}}>Completed</option>
      <option value="voided" {{#if (eq status "voided")}}selected{{/if}}>Voided</option>
    </select>
    <select name="branch" aria-label="Branch">
      <option value="">All branches</option>
      {{#each branches}}<option value="{{id}}" {{#if (eq id ../branch)}}selected{{/if}}>{{name}}</option>{{/each}}
    </select>
    <button class="button button-secondary">Filter</button>
  </form>
  <div class="table-wrap">
    <table data-keyboard-table><thead><tr><th>Reference</th><th>Date / time</th><th>Staff</th><th>Customer</th><th>Branch</th><th>Items</th><th>Payment</th><th>Payment status</th><th>Transaction status</th><th class="right">Total</th></tr></thead>
      <tbody>{{#each sales}}<tr>
        <td><a class="text-link" href="/transactions/{{this.id}}" data-row-key="Enter" data-shortcut-label="Open receipt">{{this.reference}}</a></td>
        <td>{{this.createdAt}}</td><td>{{this.User.name}}</td><td>{{#if this.Customer}}{{this.Customer.name}}<small class="table-sub">{{this.Customer.cardNumber}}</small>{{else}}Walk-in{{/if}}</td><td>{{this.Branch.name}}</td><td>{{this.itemCount}}</td>
        <td>{{#if this.paymentProvider}}{{this.paymentProvider}}{{else}}{{this.paymentMethod}}{{/if}}</td>
        <td><span class="badge {{#if (eq this.paymentStatus "paid")}}badge-ok{{else}}badge-warn{{/if}}">{{this.paymentStatus}}</span></td>
        <td>{{this.status}}</td><td class="right">₱{{this.total}}</td>
      </tr>{{else}}<tr data-no-row><td colspan="10" class="empty-state">No transactions match these filters.</td></tr>{{/each}}</tbody>
    </table>
  </div>
</section>
