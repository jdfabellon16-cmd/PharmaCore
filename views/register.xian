{{> head}}
<body class="auth-page">
  <main class="auth-card">
    <a class="brand auth-brand" href="/"><span class="brand-mark">+</span><span>PharmaCore<small>Pharmacy management</small></span></a>
    <p class="eyebrow">STAFF ACCESS</p><h1>Request an account</h1>
    <p class="muted">New accounts are set up as cashiers and need administrator approval before sign-in.</p>
    {{#if error}}<div class="alert alert-error">{{error}}</div>{{/if}}
    <form class="stack-form" method="post" action="/register">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <label>Full name<input type="text" name="name" autocomplete="name" minlength="2" maxlength="120" value="{{name}}" required></label>
      <label>Email address<input type="email" name="email" autocomplete="email" maxlength="190" value="{{email}}" required></label>
      <label>Password<input type="password" name="password" autocomplete="new-password" minlength="10" maxlength="72" required><small>Use 10–72 characters.</small></label>
      <label>Confirm password<input type="password" name="confirmPassword" autocomplete="new-password" minlength="10" maxlength="72" required></label>
      <button class="button button-primary full-width" type="submit">Submit account request</button>
    </form>
    <p class="small-muted">Already have an account? <a class="text-link" href="/login">Sign in</a></p>
  </main>
{{> footer}}
