{{> head}}
<body><div class="app-shell">{{> sidebar}}<div class="main-shell"><header class="topbar">Sales analytics<strong>{{user.name}}</strong></header><main class="content">
  <div class="page-heading"><div><p class="eyebrow">SALES OVERVIEW</p><h1>Sales history</h1><p class="muted">Completed sales per {{periodLabel}}, compared with the {{periodLabel}} before. Voided sales are not counted.</p></div></div>
  <section class="panel">
    {{> history-tabs}}
    <form class="filter-row" method="get" action="/sales-history">
      <label>Period<select name="period" data-page-filter>
        <option value="daily" {{#if (eq period "daily")}}selected{{/if}}>Daily</option>
        <option value="monthly" {{#if (eq period "monthly")}}selected{{/if}}>Monthly</option>
        <option value="yearly" {{#if (eq period "yearly")}}selected{{/if}}>Yearly</option>
      </select></label>
      <label>Branch<select name="branch" data-page-filter>
        <option value="">All branches</option>
        {{#each branches}}<option value="{{id}}" {{#if (eq id ../selectedBranch)}}selected{{/if}}>{{name}}</option>{{/each}}
      </select></label>
      <button class="button button-primary">View sales</button>
    </form>
    <div class="table-wrap"><table data-keyboard-table><thead><tr><th>{{#if (eq period "daily")}}Day{{else}}{{#if (eq period "monthly")}}Month{{else}}Year{{/if}}{{/if}}</th><th class="right">Transactions</th><th class="right">Total sales</th><th class="right">Change vs previous {{periodLabel}}</th><th></th></tr></thead><tbody>
      {{#each rows}}<tr><td><strong>{{key}}</strong></td><td class="right">{{count}}</td><td class="right">₱{{total}}</td><td class="right"><span class="{{changeClass}}">{{change}}</span><small class="table-sub">Previous: ₱{{previous}}</small></td><td class="right"><a class="text-link" href="{{link}}" data-row-key="Enter">View transactions</a></td></tr>
      {{else}}<tr data-no-row><td colspan="5" class="empty-state">No completed sales in this period.</td></tr>{{/each}}
    </tbody></table></div>
    <p class="small-muted">{{windowNote}} · Total shown: ₱{{grandTotal}}</p>
  </section>
</main></div></div><script src="/js/page-keyboard.js" defer></script>{{> footer}}
