{{> head}}
<body><div class="app-shell">{{> sidebar}}<div class="main-shell"><header class="topbar">Catalog management<strong>{{user.name}}</strong></header><main class="content">
  <div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Categories</h1><p class="muted">Categories are retained while medicines reference them.</p></div></div>
  <section class="panel"><h2>Add category</h2><form class="inline-form" method="post" action="/categories" data-keyboard-form><input type="hidden" name="_csrf" value="{{csrfToken}}"><label>Name<input name="name" required data-shortcut="N" data-shortcut-label="Add category"></label><label>Description<input name="description"></label><button class="button button-primary">Add category</button></form></section>
  <section class="panel"><div class="table-wrap"><table data-keyboard-table><thead><tr><th>Category</th><th>Description</th><th>Medicines</th><th>Update / delete</th></tr></thead><tbody>{{#each categories}}<tr><td><form class="inline-form" method="post" action="/categories/{{this.id}}/update"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><input name="name" value="{{this.name}}" required data-row-key="E" data-shortcut-label="Edit name"><input name="description" value="{{this.description}}"><button class="button button-secondary">Save</button></form></td><td>{{this.description}}</td><td>{{#each this.Medicines}}<a class="text-link" href="/medicines/{{this.id}}">{{this.name}}</a><small class="table-sub">{{this.code}}</small>{{else}}None{{/each}}</td><td><form method="post" action="/categories/{{this.id}}/delete" data-confirm="Delete this unused category?"><input type="hidden" name="_csrf" value="{{../csrfToken}}"><button class="button button-danger" data-row-key="Delete" {{#if this.Medicines.length}}disabled title="Category is in use"{{/if}}>Delete</button></form></td></tr>{{else}}<tr data-no-row><td colspan="4" class="empty-state">No categories have been added.</td></tr>{{/each}}</tbody></table></div></section>
</main></div></div><script src="/js/page-keyboard.js" defer></script>{{> footer}}
