{{> head}}
<body><div class="app-shell">{{> sidebar}}<div class="main-shell"><header class="topbar">Transaction receipt<strong>{{user.name}}</strong></header><main id="receipt-page" class="content" data-user-id="{{user.id}}">
  <div class="page-heading no-print"><div><p class="eyebrow">COMPLETED SALE</p><h1>{{sale.reference}}</h1><p class="muted">Receipt detail is stored with this transaction.</p></div><div class="receipt-actions"><a class="button button-secondary" href="/pos" data-shortcut="N F1">New transaction</a><button id="print-receipt" class="button button-primary" type="button" data-shortcut="P F10">Print receipt</button></div></div>
  <section class="panel receipt"><div class="receipt-brand">{{#if store.logo}}<img class="store-logo" src="{{store.logo}}" alt="">{{else}}<span class="brand-mark">+</span>{{/if}}<div><h2>{{store.name}}</h2><p>Pharmacy sales receipt{{#if sale.Branch}} · {{sale.Branch.name}}{{/if}}</p></div></div>
    {{#if (eq sale.status "voided")}}<p class="void-note"><strong>VOIDED</strong> {{sale.voidedAt}}{{#if sale.VoidedBy}} · approved by {{sale.VoidedBy.name}}{{/if}} · Reason: {{sale.voidReason}}. Stock was returned.</p>{{/if}}
    <div class="detail-grid receipt-meta"><div><span>Reference</span><strong>{{sale.reference}}</strong></div><div><span>Date</span><strong>{{sale.createdAt}}</strong></div><div><span>Processed by</span><strong>{{sale.User.name}}</strong></div><div><span>Customer</span><strong>{{#if sale.Customer}}{{sale.Customer.name}} ({{sale.Customer.cardNumber}}){{else}}Walk-in{{/if}}</strong></div><div><span>Status</span><strong>{{sale.status}}</strong></div><div><span>Payment</span><strong>{{#if sale.paymentProvider}}{{sale.paymentProvider}}{{else}}{{sale.paymentMethod}}{{/if}}</strong></div><div><span>Payment status</span><strong>{{sale.paymentStatus}}</strong></div>{{#if sale.paymentReference}}<div><span>Payment reference</span><strong>{{sale.paymentReference}}</strong></div>{{/if}}</div>
    {{#if sale.paymentReference}}<p class="small-muted">External payment details are recorded for reference and have not been verified by a payment gateway.</p>{{/if}}
    <div class="table-wrap"><table><thead><tr><th>Medicine</th><th>Code / batch</th><th>Qty</th><th class="right">Unit price</th><th class="right">Line total</th></tr></thead><tbody>{{#each sale.SaleItems}}<tr><td>{{medicineName}}{{#if prescriptionVerifiedAt}}<small class="table-sub">Prescription verified by {{PrescriptionVerifier.name}}</small>{{/if}}</td><td>{{medicineCode}}<small class="table-sub">{{medicineBatchNumber}}</small></td><td>{{quantity}}</td><td class="right">₱{{unitPrice}}</td><td class="right">₱{{lineTotal}}</td></tr>{{/each}}</tbody></table></div>
    <div class="receipt-totals"><div><span>Subtotal</span><strong>₱{{sale.subtotal}}</strong></div><div><span>Discount</span><strong>₱{{sale.discount}}</strong></div><div><span>Tax</span><strong>₱{{sale.tax}}</strong></div><div class="grand-total"><span>Total</span><strong>₱{{sale.total}}</strong></div><div><span>Amount received</span><strong>₱{{sale.amountReceived}}</strong></div><div><span>Change</span><strong>₱{{sale.changeDue}}</strong></div></div>
    <p class="receipt-thanks">Thank you for choosing PharmaCore.</p>
  </section>
</main></div></div><script src="/js/pos-shortcuts.js" defer></script>{{> footer}}
